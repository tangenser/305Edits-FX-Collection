<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="305Edits FX Collection" Width="1100" Height="760" MinWidth="880" MinHeight="650" WindowStartupLocation="CenterScreen" Background="#080D17" Foreground="#EDF3FF" FontFamily="Segoe UI">
 <Window.Resources>
  <Style TargetType="Button"><Setter Property="Foreground" Value="#EDF3FF"/><Setter Property="Background" Value="#17365D"/><Setter Property="BorderBrush" Value="#2D69AD"/><Setter Property="BorderThickness" Value="1"/><Setter Property="Padding" Value="18,11"/><Setter Property="Cursor" Value="Hand"/><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button"><Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1" CornerRadius="7" Padding="{TemplateBinding Padding}"><ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/></Border><ControlTemplate.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter Property="Background" Value="#22538C"/></Trigger><Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.4"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter></Style>
 </Window.Resources>
 <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="225"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
  <Border BorderBrush="#213047" BorderThickness="0,0,1,0"><Grid Margin="24,30"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
   <StackPanel><TextBlock FontSize="32" FontWeight="ExtraBold">305<Run Foreground="#3695FF">Edits</Run></TextBlock><TextBlock Text="FX COLLECTION" FontSize="10" Foreground="#849BBE" Margin="3,4,0,0"/></StackPanel>
   <StackPanel Grid.Row="1" Margin="0,52,0,0"><Border Background="#142F51" CornerRadius="7" Padding="14"><TextBlock Text="✦   Мои плагины" Foreground="#72B6FF" FontWeight="SemiBold"/></Border><TextBlock Text="Установка плагинов&#10;для Premiere Pro" Foreground="#6E83A4" Margin="14,23,0,0" LineHeight="22"/></StackPanel>
   <StackPanel Grid.Row="3"><TextBlock Text="WINDOWS / PREMIERE PRO" FontSize="9" Foreground="#5E7699"/><TextBlock Name="BuildLabel" Text="305Edits · 0.3.0" Foreground="#8BA2C4" Margin="0,8,0,15"/></StackPanel>
  </Grid></Border>
  <Grid Grid.Column="1" Margin="36,32"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
   <DockPanel><StackPanel><TextBlock Text="Плагины Premiere Pro" FontSize="29" FontWeight="SemiBold"/><TextBlock Text="Установка, обновление и выбор версий Premiere" Foreground="#8498B7" Margin="0,9,0,0"/></StackPanel><Button Name="RefreshButton" Content="↻  Обновить" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="20,0,0,0" FontSize="11"/></DockPanel>
   <Border Grid.Row="1" Background="#101D30" BorderBrush="#243B5D" BorderThickness="1" CornerRadius="9" Padding="16" Margin="0,26,0,22"><StackPanel><DockPanel><TextBlock Text="ОБНАРУЖЕННЫЕ ПРИЛОЖЕНИЯ" FontSize="9" Foreground="#6689B7" VerticalAlignment="Center"/><Button Name="LocateButton" Content="Указать путь…" FontSize="10" Padding="8,5" HorizontalAlignment="Right"/></DockPanel><TextBlock Name="HostsLabel" Text="Поиск Premiere Pro…" Margin="0,8,0,0" TextWrapping="Wrap"/></StackPanel></Border>
   <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto"><StackPanel Name="Cards"/></ScrollViewer>
   <StackPanel Grid.Row="3"><Border Height="1" Background="#1D304B" Margin="0,20,0,16"/><WrapPanel><Button Name="OnlineButton" Content="Проверить обновления" FontSize="11" Padding="13,9" Margin="0,0,10,8"/><Button Name="PackageButton" Content="Установить пакет…" FontSize="11" Padding="13,9" Margin="0,0,0,8"/></WrapPanel><TextBlock Name="StatusLabel" Text="Готов к работе" Foreground="#91B9EF" TextWrapping="Wrap" Margin="0,14,0,0"/></StackPanel>
  </Grid>
 </Grid>
</Window>
